local module = {}

local Circle

function module.Init(circleObject)
	Circle = circleObject
end

function module.SetRadius(radius)
	if not Circle then return end

	local diameter = radius * 2
	Circle.Size = UDim2.fromOffset(diameter, diameter)
end

function module.SetVisible(state)
	if Circle then
		Circle.Visible = state
	end
end

return module

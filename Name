local Players = game:GetService("Players")

local ESP = {}

local Objects = {}
local Connections = {}

local function create(player)

	if player == Players.LocalPlayer then
		return
	end

	local function characterAdded(character)

		local head = character:WaitForChild("Head",5)

		if not head then
			return
		end


		local old = head:FindFirstChild("NameESP")

		if old then
			old:Destroy()
		end


		local gui = Instance.new("BillboardGui")
		gui.Name = "NameESP"
		gui.Size = UDim2.new(0,220,0,40)
		gui.StudsOffset = Vector3.new(0,3,0)
		gui.AlwaysOnTop = true
		gui.Parent = head


		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1,1)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.fromRGB(255,255,255)
		label.TextStrokeTransparency = 0
		label.TextScaled = true
		label.Font = Enum.Font.SourceSansBold

		label.Text =
			player.DisplayName ..
			" (@" .. player.Name .. ")"

		label.Parent = gui


		Objects[player] = gui
	end


	if player.Character then
		characterAdded(player.Character)
	end


	Connections[player] =
		player.CharacterAdded:Connect(characterAdded)

end



function ESP.Enable()

	for _,player in ipairs(Players:GetPlayers()) do
		create(player)
	end


	ESP.PlayerConnection =
		Players.PlayerAdded:Connect(create)

end



function ESP.Disable()

	for _,gui in pairs(Objects) do

		if gui then
			gui:Destroy()
		end

	end


	for _,connection in pairs(Connections) do
		connection:Disconnect()
	end


	if ESP.PlayerConnection then
		ESP.PlayerConnection:Disconnect()
		ESP.PlayerConnection = nil
	end


	table.clear(Objects)
	table.clear(Connections)

end



return ESP

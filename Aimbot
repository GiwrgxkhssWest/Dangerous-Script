local CameraLock = {}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

CameraLock.Enabled = false

local Connection = nil
local Target = nil


local function GetClosestPlayer()
	local Character = LocalPlayer.Character

	if not Character then
		return nil
	end

	local Root = Character:FindFirstChild("HumanoidRootPart")

	if not Root then
		return nil
	end


	local Closest = nil
	local Distance = math.huge


	for _, Player in ipairs(Players:GetPlayers()) do

		if Player ~= LocalPlayer then

			local TargetCharacter = Player.Character
			local Head = TargetCharacter and TargetCharacter:FindFirstChild("Head")

			if Head then

				local CurrentDistance =
					(Root.Position - Head.Position).Magnitude

				if CurrentDistance < Distance then
					Distance = CurrentDistance
					Closest = Player
				end

			end
		end
	end


	return Closest
end



function CameraLock.Enable()

	if CameraLock.Enabled then
		return
	end

	CameraLock.Enabled = true

	print("[CameraLock] Enabled")


	Connection = RunService.RenderStepped:Connect(function()

		Target = GetClosestPlayer()


		if Target
			and Target.Character
			and Target.Character:FindFirstChild("Head") then

			local Head = Target.Character.Head

			Camera.CameraType = Enum.CameraType.Scriptable

			Camera.CFrame = CFrame.lookAt(
				Camera.CFrame.Position,
				Head.Position
			)

		end

	end)

end



function CameraLock.Disable()

	CameraLock.Enabled = false

	print("[CameraLock] Disabled")


	if Connection then
		Connection:Disconnect()
		Connection = nil
	end


	Camera.CameraType = Enum.CameraType.Custom

end



return CameraLock

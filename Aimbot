local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local Aimbot = {}

Aimbot.Enabled = false
Aimbot.Target = nil

local connection

function Aimbot.SetTarget(player)
	Aimbot.Target = player
end

function Aimbot.Enable()
	if Aimbot.Enabled then return end

	Aimbot.Enabled = true

	connection = RunService.RenderStepped:Connect(function()
		if not Aimbot.Enabled then return end
		if not Aimbot.Target then return end
		if not Aimbot.Target.Character then return end

		local head = Aimbot.Target.Character:FindFirstChild("Head")
		if not head then return end

		Camera.CFrame = CFrame.lookAt(
			Camera.CFrame.Position,
			head.Position
		)
	end)
end

function Aimbot.Disable()
	Aimbot.Enabled = false

	if connection then
		connection:Disconnect()
		connection = nil
	end
end

return Aimbot

local CameraLock = {}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

CameraLock.Enabled = false
CameraLock.Target = nil

local Connection

function CameraLock.SetTarget(Player)
	CameraLock.Target = Player
	print("[CameraLock] Target:", Player and Player.Name or "None")
end


function CameraLock.Enable()

	if CameraLock.Enabled then
		return
	end

	CameraLock.Enabled = true

	print("[CameraLock] Enabled")

	Connection = RunService.RenderStepped:Connect(function()

		if not CameraLock.Enabled then
			return
		end

		if not CameraLock.Target then
			return
		end

		local Character = CameraLock.Target.Character

		if not Character then
			return
		end

		local Head = Character:FindFirstChild("Head")

		if not Head then
			return
		end

		Camera.CFrame = CFrame.lookAt(
			Camera.CFrame.Position,
			Head.Position
		)

	end)

end


function CameraLock.Disable()

	if not CameraLock.Enabled then
		return
	end

	CameraLock.Enabled = false

	print("[CameraLock] Disabled")

	if Connection then
		Connection:Disconnect()
		Connection = nil
	end

end


return CameraLock
